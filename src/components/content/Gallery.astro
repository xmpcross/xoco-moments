---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import { strings } from "@/config/strings";
import { lightboxRendition, postImage } from "@/lib/images";

/**
 * A set of photographs inside a story, packed into justified rows.
 *
 * A grid lays every frame out at one shape, which means cropping a horizontal
 * picture into a vertical slot. Here the frames are packed by their own
 * proportions instead: a horizontal picture takes a wide slot, a vertical one
 * a narrow slot, and two small frames can stack inside one slot when that
 * fills the row better. Every row runs the full width at one height, so the
 * gallery ends flush and no frame is cropped to fit a grid.
 *
 * Which frames share a row is decided for the whole gallery at once, by
 * dynamic programming over them in the writer's order, so the reading order is
 * never rearranged to suit the packing.
 */
export interface GalleryImage {
  /** An imported image, or a filename resolved against `folder`. */
  src: ImageMetadata | string;
  alt: string;
  caption?: string;
  credit?: string;
}

/**
 * The short form a story normally uses: `["g1.webp", "Alt text"]`, with
 * `folder` naming the story's own directory.
 */
export type GalleryEntry = GalleryImage | [file: string, alt: string];

interface Props {
  images: GalleryEntry[];
  /**
   * The story's folder under `src/content/posts/`, so frames can be named by
   * filename instead of imported one by one at the top of the file.
   */
  folder?: string;
  /**
   * Lightbox group. Every photograph on a page shares one by default, so the
   * arrows walk the whole story in the order it was written. Name a group to
   * keep a set to itself.
   */
  group?: string;
  /** Accessible name for the set. Not printed. */
  label?: string;
  /** Printed under the whole gallery. Per-image captions show in the lightbox. */
  caption?: string;
}

const { images, folder, group = "story", label = strings.lightbox.gallery, caption } = Astro.props;

/* Both shapes land on the same object, so everything below only ever deals
   with a resolved image. */
const frames = images.map((entry) => {
  const image: GalleryImage = Array.isArray(entry) ? { src: entry[0], alt: entry[1] } : entry;
  return {
    ...image,
    src: typeof image.src === "string" ? postImage(image.src, folder) : image.src,
  };
});

/* Renditions for the lightbox, resolved at build time so a click costs one
   request and no client-side work. */
const full = await Promise.all(frames.map((frame) => lightboxRendition(frame.src)));
---

<figure class="gallery" aria-label={label}>
  <div class="gallery-rows" data-gallery>
    {
      frames.map((image, index) => (
        <button
          class="gallery-frame"
          type="button"
          data-lightbox
          data-lightbox-group={group}
          data-lightbox-src={full[index].src}
          data-lightbox-srcset={full[index].srcSet.attribute}
          data-lightbox-alt={image.alt}
          data-lightbox-caption={image.caption ?? ""}
          data-lightbox-credit={image.credit ?? ""}
          aria-label={strings.lightbox.enlargeOf(index + 1, frames.length, image.alt)}
        >
          {/* `sizes` is corrected to the packed slot width by `AutoSizes`:
              a row can hand one frame two thirds of the window, which no
              build-time guess can anticipate. */}
          <Image
            src={image.src}
            alt={image.alt}
            widths={[400, 600, 900, 1200, 1600, 2000]}
            sizes="(min-width: 64rem) 34vw, (min-width: 40rem) 48vw, 94vw"
            loading="lazy"
            decoding="async"
            data-autosize
          />
        </button>
      ))
    }
  </div>

  {caption && <figcaption class="gallery-caption">{caption}</figcaption>}
</figure>

<script>
  /* Slots across a row, and the most frames a row may hold once stacks are
     counted. On a narrow window that lets a stack sit beside one frame, so a
     set of three does not end on a lone frame the width of the window. */
  const SLOTS_WIDE = 3;
  const SLOTS_NARROW = 2;
  const FRAMES_MAX = 3;
  /* Cost nudges: a stack is fine, a frame alone across the window is a last
     resort. */
  const STACK_COST = 0.12;
  const LONE_COST = 0.6;
  /* A stack narrower than this share of the row is two thumbnails. */
  const STACK_MIN_SHARE = 0.35;

  type Slot = number[];
  type Row = Slot[];

  const ratioOf = (frame: HTMLElement) => {
    const image = frame.querySelector("img");
    const width = Number(image?.getAttribute("width")) || image?.naturalWidth;
    const height = Number(image?.getAttribute("height")) || image?.naturalHeight;

    // Height per unit of width.
    return width && height ? height / width : 1;
  };

  /*
   * Plan the rows. `ratios` are heights per unit width; the plan is a list of
   * rows, each a list of slots, each slot the indexes of one or two frames.
   */
  const plan = (ratios: number[], width: number, gap: number, slotsAcross: number): Row[] => {
    const count = ratios.length;
    const target = (width / slotsAcross) * 0.95;
    const memo = new Map<number, { cost: number; rows: Row[] }>();

    const slotAspect = (slot: Slot) => 1 / slot.reduce((sum, index) => sum + ratios[index], 0);

    const rowCost = (slots: Row, isLast: boolean) => {
      const aspects = slots.reduce((sum, slot) => sum + slotAspect(slot), 0);
      const height = (width - gap * (slots.length - 1)) / aspects;
      let cost = ((height - target) / target) ** 2;

      // A row far shorter than the target is a strip of thumbnails.
      if (height < target * 0.55) cost += 2;

      slots.forEach((slot) => {
        if (slot.length === 1) return;
        cost += STACK_COST;
        if (height * slotAspect(slot) < width * STACK_MIN_SHARE) cost += 2;
      });
      if (slots.length === 1 && !isLast) cost += LONE_COST;

      // The last row may run a little off target without looking wrong.
      return isLast ? cost * 0.5 : cost;
    };

    /** Cheapest way to lay out frames from `start` to the end. */
    const solve = (start: number): { cost: number; rows: Row[] } => {
      if (start >= count) return { cost: 0, rows: [] };

      const cached = memo.get(start);
      if (cached) return cached;

      let best: { cost: number; rows: Row[] } | null = null;

      const extend = (next: number, slots: Row) => {
        if (slots.length) {
          const isLast = next >= count;
          const rest = isLast ? { cost: 0, rows: [] as Row[] } : solve(next);
          const cost = rowCost(slots, isLast) + rest.cost;
          if (!best || cost < best.cost) best = { cost, rows: [slots, ...rest.rows] };
        }

        const used = next - start;
        if (next >= count || slots.length >= slotsAcross || used >= FRAMES_MAX) return;

        extend(next + 1, [...slots, [next]]);

        // Two frames stacked in one slot, when there are enough to matter.
        if (next + 1 < count && count > 2 && used + 2 <= FRAMES_MAX) {
          extend(next + 2, [...slots, [next, next + 1]]);
        }
      };

      extend(start, []);
      const result = best ?? { cost: 0, rows: [] };
      memo.set(start, result);
      return result;
    };

    return solve(0).rows;
  };

  interface Board {
    container: HTMLElement;
    frames: HTMLElement[];
    ratios: number[];
    key: string;
  }

  const build = ({ container, frames, ratios }: Board, rows: Row[]) => {
    container
      .querySelectorAll(".gallery-row, .gallery-stack")
      .forEach((node) => node.remove());
    container.classList.add("is-justified");

    rows.forEach((slots) => {
      const row = document.createElement("div");
      row.className = "gallery-row";

      slots.forEach((slot) => {
        const aspect = 1 / slot.reduce((sum, index) => sum + ratios[index], 0);

        if (slot.length === 1) {
          const frame = frames[slot[0]];
          frame.style.setProperty("--slot-aspect", String(aspect));
          row.append(frame);
          return;
        }

        const stack = document.createElement("div");
        stack.className = "gallery-stack";
        stack.style.setProperty("--slot-aspect", String(aspect));

        slot.forEach((index) => {
          const frame = frames[index];
          // The stack's height is shared out by each frame's own height.
          frame.style.setProperty("--stack-share", String(ratios[index]));
          frame.style.removeProperty("--slot-aspect");
          stack.append(frame);
        });

        row.append(stack);
      });

      container.append(row);
    });
  };

  const layout = (board: Board) => {
    const styles = getComputedStyle(board.container);
    const width =
      board.container.getBoundingClientRect().width -
      Number.parseFloat(styles.paddingLeft) -
      Number.parseFloat(styles.paddingRight);
    const gap = Number.parseFloat(styles.columnGap) || 0;
    const slotsAcross = window.matchMedia("(min-width: 64rem)").matches
      ? SLOTS_WIDE
      : SLOTS_NARROW;
    /* Rounded to the nearest 40px, so a scrollbar appearing or a pinch-zoom
       does not replan the whole gallery on every frame. */
    const key = `${slotsAcross}:${Math.round(width / 40)}`;

    if (!width || board.key === key) return;

    board.key = key;
    build(board, plan(board.ratios, width, gap, slotsAcross));
  };

  const boards: Board[] = [...document.querySelectorAll<HTMLElement>("[data-gallery]")]
    .map((container) => ({
      container,
      frames: [...container.querySelectorAll<HTMLElement>(".gallery-frame")],
      ratios: [] as number[],
      key: "",
    }))
    .filter((board) => board.frames.length > 1);

  if (boards.length) {
    boards.forEach((board) => {
      board.ratios = board.frames.map(ratioOf);
    });

    const run = () => boards.forEach(layout);
    run();

    let queued = false;
    window.addEventListener(
      "resize",
      () => {
        if (queued) return;
        queued = true;
        window.requestAnimationFrame(() => {
          queued = false;
          run();
        });
      },
      { passive: true },
    );
  }
</script>
