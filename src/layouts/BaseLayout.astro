---
import type { AstroComponentFactory } from "astro/runtime/server/index.js";
import type { ImageMetadata } from "astro";
import { siteConfig } from "@/config/site";
import { strings } from "@/config/strings";
import { websiteSchema } from "@/lib/schema";
import { getSocialCard } from "@/lib/social-card";
import "@/styles/global.css";

interface Props {
  title?: string;
  description?: string;
  /**
   * The share card. Hand it an imported image — a story's cover — and it is
   * cropped to card proportions at build time. A string path is used as-is,
   * for images that already live in `public/`.
   */
  image?: ImageMetadata | string;
  imageAlt?: string;
  type?: "website" | "article";
  /** Dates and taxonomy for the `article:*` tags. Only read when `type` is "article". */
  article?: { published: Date; modified?: Date; section?: string; tags?: string[] };
  noindex?: boolean;
  prevUrl?: string;
  nextUrl?: string;
  structuredData?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title = siteConfig.title,
  description = siteConfig.description,
  image,
  imageAlt,
  type = "website",
  article,
  noindex = false,
  prevUrl,
  nextUrl,
  structuredData,
} = Astro.props;

const card = image && typeof image !== "string" ? await getSocialCard(image) : undefined;
const socialImage = card?.src ?? (typeof image === "string" ? image : siteConfig.socialImage);
const socialImageAlt = imageAlt ?? `${siteConfig.name} — ${siteConfig.tagline}`;

const canonical = new URL(Astro.url.pathname, siteConfig.siteUrl).toString();
/* Rendered onto <html> so a pinned default paints correctly on the first
   frame. "system" cannot be known at build time, so it starts light and the
   blocking script below corrects it before paint. */
const defaultColorMode = siteConfig.defaultColorMode;
const initialTheme = defaultColorMode === "dark" ? "dark" : "light";
const themeColors = siteConfig.themeColor;
const themeLabels = { light: strings.nav.toDark, dark: strings.nav.toLight };
const absoluteImage = new URL(socialImage, siteConfig.siteUrl).toString();
const pageTitle = title === siteConfig.title ? title : `${title} | ${siteConfig.name}`;
const schema = structuredData ?? websiteSchema();

// Optional: renders nothing once the file is deleted.
const BuyButton = Object.values(
  import.meta.glob<{ default: AstroComponentFactory }>("../components/BuyButton.astro", {
    eager: true,
  }),
)[0]?.default;
---

<!doctype html>
<html lang={siteConfig.language} data-theme={initialTheme}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link
      rel="preload"
      href="/fonts/marcellus/Marcellus-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/inter/Inter-Variable-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content={themeColors[initialTheme]} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="canonical" href={canonical} />
    {prevUrl && <link rel="prev" href={new URL(prevUrl, siteConfig.siteUrl).toString()} />}
    {nextUrl && <link rel="next" href={new URL(nextUrl, siteConfig.siteUrl).toString()} />}
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta property="og:locale" content={siteConfig.locale} />
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={siteConfig.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={absoluteImage} />
    <meta property="og:image:alt" content={socialImageAlt} />
    {
      card && (
        <>
          <meta property="og:image:type" content="image/jpeg" />
          <meta property="og:image:width" content={String(card.width)} />
          <meta property="og:image:height" content={String(card.height)} />
        </>
      )
    }
    {
      type === "article" && article && (
        <>
          <meta property="article:published_time" content={article.published.toISOString()} />
          <meta
            property="article:modified_time"
            content={(article.modified ?? article.published).toISOString()}
          />
          {article.section && <meta property="article:section" content={article.section} />}
          {article.tags?.map((tag) => <meta property="article:tag" content={tag} />)}
        </>
      )
    }
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={absoluteImage} />
    <meta name="twitter:image:alt" content={socialImageAlt} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />
    <script is:inline define:vars={{ defaultColorMode, themeColors, themeLabels }}>
      (() => {
        const root = document.documentElement;

        /* Marks the document as scripted, which is what arms every reveal.
           Without it the page renders in full rather than blank: an animation
           must never be the thing that makes content appear. */
        root.classList.add("js");

        const storageKey = "moments-color-mode";
        const themePreference = window.matchMedia("(prefers-color-scheme: dark)");
        const themeColorMeta = document.querySelector('meta[name="theme-color"]');
        let storedTheme;

        try {
          storedTheme = localStorage.getItem(storageKey);
        } catch {
          storedTheme = null;
        }

        const updateThemeButtons = (theme) => {
          document.querySelectorAll("[data-theme-toggle]").forEach((button) => {
            button.setAttribute("aria-label", themeLabels[theme]);
          });
        };

        const setTheme = (theme, persist = false) => {
          root.dataset.theme = theme;
          themeColorMeta?.setAttribute("content", themeColors[theme]);
          if (persist) {
            storedTheme = theme;
            try {
              localStorage.setItem(storageKey, theme);
            } catch {}
          }
          updateThemeButtons(theme);
        };

        /* A stored choice always wins. Otherwise the site's configured default
           applies, and only "system" defers to the operating system. */
        const preferredTheme =
          storedTheme === "light" || storedTheme === "dark"
            ? storedTheme
            : defaultColorMode === "system"
              ? themePreference.matches
                ? "dark"
                : "light"
              : defaultColorMode;

        setTheme(preferredTheme);

        themePreference.addEventListener("change", (event) => {
          if (defaultColorMode !== "system") return;
          if (storedTheme === "light" || storedTheme === "dark") return;
          setTheme(event.matches ? "dark" : "light");
        });

        window.addEventListener("DOMContentLoaded", () => {
          updateThemeButtons(root.dataset.theme || preferredTheme);
          document.querySelectorAll("[data-theme-toggle]").forEach((button) => {
            button.addEventListener("click", () => {
              setTheme(root.dataset.theme === "dark" ? "light" : "dark", true);
            });
          });

          const targets = document.querySelectorAll("[data-reveal]");
          if (!targets.length) return;

          if (
            !("IntersectionObserver" in window) ||
            window.matchMedia("(prefers-reduced-motion: reduce)").matches
          ) {
            targets.forEach((target) => target.classList.add("is-revealed"));
            return;
          }

          const observer = new IntersectionObserver(
            (entries) => {
              entries.forEach((entry) => {
                if (!entry.isIntersecting) return;
                entry.target.classList.add("is-revealed");
                observer.unobserve(entry.target);
              });
            },
            /* Fire as soon as any part of the block enters, and reach 10% past
               the bottom edge, so a section just under the fold has already
               arrived by the time it is scrolled to. */
            { threshold: 0, rootMargin: "0px 0px 10% 0px" },
          );

          /* A group staggers its children rather than revealing them at once:
             the attribute's value is the step in milliseconds. */
          document.querySelectorAll("[data-reveal-group]").forEach((group) => {
            const step = Number(group.getAttribute("data-reveal-group")) || 0;
            group.querySelectorAll("[data-reveal]").forEach((item, index) => {
              item.style.setProperty("--reveal-delay", `${index * step}ms`);
            });
          });

          targets.forEach((target) => observer.observe(target));
        });
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#content">{strings.skipToContent}</a>
    <slot />
    {BuyButton && <BuyButton />}
  </body>
</html>
