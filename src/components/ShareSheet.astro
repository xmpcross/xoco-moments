---
import LocalIcon from "@/components/LocalIcon.astro";
import Icon from "@/components/ui/Icon.astro";
import { siteConfig } from "@/config/site";
import { strings } from "@/config/strings";

/**
 * The share sheet: the targets a photographer's readers actually use, the
 * long tail folded behind "More", and the page link with a copy button.
 *
 * Every target is a plain link, so the sheet works the moment it opens even
 * where the clipboard is unavailable. It is a native `<dialog>`, which
 * supplies the focus trap, the Escape key and the backdrop.
 *
 * One sheet per page, opened by any number of `ShareButton`s.
 */
interface Props {
  title: string;
  /** Absolute URL. Defaults to the canonical URL of the page being rendered. */
  url?: string;
  id?: string;
}

const { title, url, id = "share-sheet" } = Astro.props;

const shareUrl = url ?? new URL(Astro.url.pathname, siteConfig.siteUrl).toString();
const link = encodeURIComponent(shareUrl);
const text = encodeURIComponent(title);

/* Each service keeps its own colour, which is how someone finds the one they
   want without reading the labels: the one place the theme's monochrome rule
   is deliberately suspended. */
const targets = [
  {
    label: "Pinterest",
    icon: "pinterest",
    brand: "#d5001f",
    href: `https://pinterest.com/pin/create/button/?url=${link}&description=${text}`,
  },
  {
    label: "Instagram",
    icon: "instagram",
    brand: "#c13584",
    href: `https://www.instagram.com/`,
  },
  {
    label: "Facebook",
    icon: "facebook",
    brand: "#1877f2",
    href: `https://www.facebook.com/sharer/sharer.php?u=${link}`,
  },
  {
    label: "WhatsApp",
    icon: "whatsapp",
    brand: "#1eb355",
    href: `https://api.whatsapp.com/send?text=${text}%20${link}`,
  },
  {
    label: "Email",
    icon: "envelope",
    brand: "#c2413f",
    href: `mailto:?subject=${text}&body=${link}`,
  },
  {
    label: "X",
    icon: "twitter-x",
    brand: "#0e0e0c",
    href: `https://x.com/intent/tweet?text=${text}&url=${link}`,
  },
  {
    label: "Bluesky",
    icon: "bluesky",
    brand: "#1185fe",
    href: `https://bsky.app/intent/compose?text=${text}%20${link}`,
  },
] as const;

/** Revealed by "More" — the ones a minority of readers actually use. */
const extraTargets = [
  {
    label: "Threads",
    icon: "threads",
    brand: "#0e0e0c",
    href: `https://www.threads.net/intent/post?text=${text}%20${link}`,
  },
  {
    label: "Telegram",
    icon: "telegram",
    brand: "#2596d8",
    href: `https://t.me/share/url?url=${link}&text=${text}`,
  },
  {
    label: "LinkedIn",
    icon: "linkedin",
    brand: "#0a66c2",
    href: `https://www.linkedin.com/sharing/share-offsite/?url=${link}`,
  },
  {
    label: "Reddit",
    icon: "reddit",
    brand: "#e03d00",
    href: `https://www.reddit.com/submit?url=${link}&title=${text}`,
  },
] as const;
---

<dialog id={id} class="sheet" aria-labelledby={`${id}-title`} data-share-sheet>
  <div class="sheet-panel">
    <div class="sheet-head">
      <h2 id={`${id}-title`} class="title-md">{strings.share.title}</h2>
      <button type="button" class="icon-btn" aria-label={strings.share.close} data-share-close>
        <Icon name="close" size={18} />
      </button>
    </div>

    <ul class="sheet-targets">
      {
        targets.map((target) => (
          <li>
            <a
              class="sheet-target"
              style={`--brand-mark:${target.brand}`}
              href={target.href}
              target="_blank"
              rel="noreferrer"
              data-share-target
            >
              <span class="sheet-icon">
                <LocalIcon name={target.icon} className="h-5 w-5" />
              </span>
              <span class="sheet-label">{target.label}</span>
            </a>
          </li>
        ))
      }

      <li data-share-more-item>
        <button type="button" class="sheet-target sheet-target-quiet" data-share-more>
          <span class="sheet-icon">
            <LocalIcon name="three-dots" className="h-5 w-5" />
          </span>
          <span class="sheet-label">{strings.share.more}</span>
        </button>
      </li>

      {
        extraTargets.map((target) => (
          <li hidden data-share-extra>
            <a
              class="sheet-target"
              style={`--brand-mark:${target.brand}`}
              href={target.href}
              target="_blank"
              rel="noreferrer"
              data-share-target
            >
              <span class="sheet-icon">
                <LocalIcon name={target.icon} className="h-5 w-5" />
              </span>
              <span class="sheet-label">{target.label}</span>
            </a>
          </li>
        ))
      }
    </ul>

    <div class="sheet-link">
      <p class="sheet-link-label">{strings.share.pageLink}</p>
      <div class="sheet-link-row">
        <input
          class="sheet-field"
          type="text"
          readonly
          value={shareUrl}
          aria-label={strings.share.pageLink}
          data-share-url
        />
        <button
          type="button"
          class="sheet-copy"
          data-share-copy
          data-copy-url={shareUrl}
          data-label-copy={strings.share.copy}
          data-label-copied={strings.share.copied}
          data-label-fallback={strings.share.copyFallback}
        >
          <LocalIcon name="clipboard" className="h-3.5 w-3.5" />
          <span aria-live="polite" data-share-copy-label>{strings.share.copy}</span>
        </button>
      </div>
    </div>
  </div>
</dialog>

<script>
  const sheet = document.querySelector<HTMLDialogElement>("[data-share-sheet]");

  if (sheet && typeof sheet.showModal === "function") {
    let opener: HTMLElement | null = null;

    const close = () => {
      if (sheet.open) sheet.close();
    };

    document.querySelectorAll<HTMLButtonElement>("[data-share-open]").forEach((button) => {
      button.addEventListener("click", () => {
        opener = button;
        if (!sheet.open) sheet.showModal();
        document.documentElement.classList.add("has-open-share");
      });
    });

    sheet.addEventListener("close", () => {
      document.documentElement.classList.remove("has-open-share");
      opener?.focus({ preventScroll: true });
      opener = null;
    });

    /* A click that lands on the dialog itself is a click on the backdrop: the
       panel inside it covers everything else. */
    sheet.addEventListener("click", (event) => {
      if (event.target === sheet) close();
    });

    sheet.querySelectorAll("[data-share-close]").forEach((button) => {
      button.addEventListener("click", close);
    });

    sheet.addEventListener("keydown", (event) => {
      if (event.key !== "Escape") return;
      event.preventDefault();
      close();
    });

    /* A target opens in another tab, so the sheet has done its job. */
    sheet.querySelectorAll("[data-share-target]").forEach((target) => {
      target.addEventListener("click", close);
    });

    sheet.querySelector<HTMLButtonElement>("[data-share-more]")?.addEventListener("click", () => {
      sheet.querySelectorAll<HTMLElement>("[data-share-extra]").forEach((item) => {
        item.hidden = false;
      });
      const moreItem = sheet.querySelector<HTMLElement>("[data-share-more-item]");
      if (moreItem) moreItem.hidden = true;
    });

    const copyButton = sheet.querySelector<HTMLButtonElement>("[data-share-copy]");
    const copyLabel = sheet.querySelector<HTMLElement>("[data-share-copy-label]");
    const field = sheet.querySelector<HTMLInputElement>("[data-share-url]");
    let restore: number | undefined;

    copyButton?.addEventListener("click", async () => {
      const url = copyButton.getAttribute("data-copy-url");
      if (!url || !copyLabel) return;

      let message = copyButton.dataset.labelCopied ?? "";

      try {
        if (!navigator.clipboard?.writeText) throw new Error("Clipboard unavailable");
        await navigator.clipboard.writeText(url);
      } catch {
        /* Selecting the field at least leaves something to copy by hand. */
        field?.select();
        message = copyButton.dataset.labelFallback ?? "";
      }

      copyLabel.textContent = message;
      window.clearTimeout(restore);
      restore = window.setTimeout(() => {
        copyLabel.textContent = copyButton.dataset.labelCopy ?? "";
      }, 2400);
    });
  }
</script>

<style>
  /* The dialog itself is the full window, with the panel centred inside it.
     Left to the browser's own box the sheet lands at the top of the page and
     reads as though it fell out of the corner. */
  .sheet {
    position: fixed;
    inset: 0;
    display: grid;
    width: 100%;
    max-width: none;
    height: 100dvh;
    max-height: none;
    place-items: center;
    margin: 0;
    padding: 1.25rem;
    border: 0;
    background: transparent;
    color: var(--foreground);
  }

  .sheet:not([open]) {
    display: none;
  }

  .sheet::backdrop {
    background: oklch(0.1 0 0 / 58%);
  }

  .sheet-panel {
    width: 100%;
    max-width: 26rem;
    max-height: calc(100dvh - 2.5rem);
    overflow-y: auto;
    padding: 1.5rem;
    border: var(--rule-thin);
    background: var(--surface);
  }

  .sheet-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1.35rem;
  }

  .sheet-targets {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1rem 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media (max-width: 26rem) {
    .sheet-targets {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .sheet-targets li[hidden] {
    display: none;
  }

  .sheet-target {
    display: grid;
    width: 100%;
    gap: 0.5rem;
    justify-items: center;
    padding: 0;
    border: 0;
    background: none;
    color: var(--muted-foreground);
    font-family: var(--font-label);
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.01em;
    text-align: center;
  }

  .sheet-target:hover {
    color: var(--foreground);
  }

  .sheet-icon {
    display: grid;
    width: 2.75rem;
    height: 2.75rem;
    place-items: center;
    background: var(--brand-mark, var(--muted));
    color: #fff;
    transition: transform 0.2s var(--ease);
  }

  .sheet-target-quiet .sheet-icon {
    background: var(--muted);
    color: var(--foreground);
  }

  .sheet-target:hover .sheet-icon {
    transform: translateY(-2px);
  }

  .sheet-label {
    line-height: 1.2;
  }

  .sheet-link {
    margin-top: 1.5rem;
    padding-top: 1.25rem;
    border-top: var(--rule-thin);
  }

  .sheet-link-label {
    color: var(--muted-foreground);
    font-size: 0.75rem;
  }

  .sheet-link-row {
    display: flex;
    align-items: stretch;
    margin-top: 0.6rem;
    overflow: hidden;
    border: var(--rule-thin);
    background: var(--background-wash);
  }

  .sheet-field {
    flex: 1;
    min-width: 0;
    padding: 0.6rem 0.75rem;
    border: 0;
    background: none;
    color: var(--muted-foreground);
    font-size: 0.75rem;
    text-overflow: ellipsis;
  }

  .sheet-field:focus {
    outline: none;
  }

  .sheet-copy {
    display: inline-flex;
    flex: none;
    align-items: center;
    gap: 0.45rem;
    padding-inline: 0.9rem;
    border: 0;
    border-left: var(--rule-thin);
    background: var(--surface);
    color: var(--foreground);
    font-family: var(--font-label);
    font-size: 0.75rem;
    font-weight: 500;
    white-space: nowrap;
  }

  .sheet-copy:hover {
    color: var(--accent-text);
  }

  @media (prefers-reduced-motion: reduce) {
    .sheet-icon,
    .sheet-target:hover .sheet-icon {
      transform: none;
      transition: none;
    }
  }
</style>
